DATABASE_URI=postgres://pulse:pulse@127.0.0.1:5432/pulse_cms
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Server ---
# Absolute base URL Payload uses to build every security-sensitive link it
# generates (e.g. the password-reset link emailed by `POST /api/find-password`).
# Defaults to http://localhost:3000 for local dev only. Always set this
# explicitly to the real public origin outside local development — Payload
# never falls back to the request's `Origin` header for this (CWE-640
# host/reset-link poisoning; see phase1-final-review.md I-1).
# PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# --- Seed (`pnpm seed`) ---
# Credentials for the super-admin user created by the `super-admin` seed
# step. Defaults below are for local dev only — always set both explicitly
# outside local development.
# SEED_ADMIN_EMAIL=admin@publicpulse.com.bd
# SEED_ADMIN_PASSWORD=changeme-dev-only!

# --- Admin security (Task 2C) ---
# Admin IP access control (default-deny allowlist). Enforcement is ON by
# default; while NO rules exist (or the ruleset is unarmed) the admin stays
# open. ESCAPE HATCH: set to `off` (also `false`/`0`/`no`) to fully bypass the
# IP guard — the documented recovery if a misconfigured allowlist (or a missing
# TRUSTED_PROXY_HOPS below) locks everyone out. Checked before the DB is touched,
# so it works even if Postgres is down.
# ADMIN_IP_ENFORCEMENT=off
#
# !!! REQUIRED FOR IP ENFORCEMENT IN PRODUCTION !!!
# Number of TRUSTED reverse-proxy hops in front of the app (integer, default 0).
# X-Forwarded-For / X-Real-IP are client-SPOOFABLE, so the guard only trusts a
# client IP when you declare your proxy topology here:
#   - 0 (default): NO trusted proxy. Forwarding headers are ignored for
#     enforcement. In production, once the allowlist is ARMED (has an active
#     in-window rule) and there is no trustworthy IP, the guard FAILS CLOSED
#     (503) rather than honor a spoofable header — set this var (or the escape
#     hatch above) to proceed. A fresh/unarmed install stays open. Dev is
#     permissive so localhost is never bricked.
#   - N>0: trust the Nth-from-the-right XFF entry (the hop YOUR proxy appended).
#     Set N = the exact number of proxies (e.g. nginx=1, CDN+nginx=2) between the
#     public client and this app. Too HIGH = SPOOFABLE (you count past your own
#     proxies into the client-controlled left part of the chain, trusting an
#     attacker-supplied entry); too low = wrong IP (you read one of your own
#     proxies' addresses instead of the client's, but it is not spoofable).
# TRUSTED_PROXY_HOPS=1
#
# Idle auto-logout window, in minutes (default 30). A client-side inactivity
# timer warns near expiry and then performs a real logout. Separate from the
# hard server-side session lifetime (Payload token expiry).
# ADMIN_IDLE_TIMEOUT_MIN=30

# --- Public endpoint rate limiting (Task 2D) ---
# In-memory fixed-window limiter for the unauthenticated public endpoints
# (account-request, find-id, find-password, and the built-in password-reset
# submission). Defaults: 10 requests per 10-minute window, per client IP + per
# endpoint. Over the limit returns HTTP 429 (generic message + Retry-After).
# PUBLIC_RATE_LIMIT_MAX=10
# PUBLIC_RATE_LIMIT_WINDOW_MIN=10
#
# NOTE (per-instance): the store is process-local, so limits apply PER running
# instance — behind N instances the effective limit is max×N. A distributed
# (Redis) store is a Phase-7 concern, like the OTP throttle. The bucket key
# reuses the TRUSTED_PROXY_HOPS trust model above: without a trusted proxy, all
# clients without a trustworthy IP share ONE bucket per endpoint (spoof-proof,
# but conservative) — declare TRUSTED_PROXY_HOPS for per-client limits.

# --- Email (nodemailer) ---
# Defaults derive from src/branding.ts when unset.
# EMAIL_FROM_ADDRESS=support@publicpulse.com.bd
# EMAIL_FROM_NAME=U-CMS
# SMTP host/port default to Mailpit's dev SMTP listener (`docker compose up -d mailpit`).
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- Storage ---
# STORAGE_DRIVER=local switches to Payload's local filesystem storage for the
# `media` collection (default). Set to `s3` to enable S3-compatible storage.
# STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
