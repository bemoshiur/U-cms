DATABASE_URI=postgres://pulse:pulse@127.0.0.1:5432/pulse_cms
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Server ---
# Absolute base URL Payload uses to build every security-sensitive link it
# generates (e.g. the password-reset link emailed by `POST /api/find-password`).
# Defaults to http://localhost:3000 for local dev only. Always set this
# explicitly to the real public origin outside local development — Payload
# never falls back to the request's `Origin` header for this (CWE-640
# host/reset-link poisoning; see phase1-final-review.md I-1). Resolution order
# (all server-controlled): PAYLOAD_PUBLIC_SERVER_URL -> SERVER_URL -> VERCEL_URL
# (Vercel injects the deployment host automatically; prefer setting a STABLE
# domain here because VERCEL_URL changes per deploy) -> localhost:3000.
# PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# SERVER_URL=  # optional alias for PAYLOAD_PUBLIC_SERVER_URL

# --- Public frontend site ---
# The site the public frontend renders (the seeded user-facing site). Set to
# `demo` on the demo deploy.
# PUBLIC_SITE_ID=demo

# --- Seed (`pnpm seed`, or `pnpm ci:seed` on deploy) ---
# Credentials for the super-admin user created by the `super-admin` seed
# step. Defaults below are for local dev only.
# SEED_ADMIN_EMAIL=admin@publicpulse.com.bd
# SEED_ADMIN_PASSWORD=changeme-dev-only!
#
# SECURITY — SEED_ADMIN_PASSWORD is REQUIRED in production. When
# NODE_ENV=production, the super-admin seed HARD-REFUSES to create the admin
# with the built-in default password above (a known credential on a public URL
# is an exposure): it throws and the seed/deploy fails fast until you set
# SEED_ADMIN_PASSWORD to a strong, unique value. Dev/test with the default is
# unaffected. (SEED_ADMIN_EMAIL's default is fine; only the password is gated.)
#
# Credentials for the login-capable demo MEMBER created by the `members` seed
# step (Task 4B). Dev-only default below.
# SEED_MEMBER_PASSWORD=Pulse-Member-2026
#
# SECURITY — SEED_MEMBER_PASSWORD is REQUIRED when a production seed creates the
# demo member. When NODE_ENV=production and the `members` step runs, the seed
# HARD-REFUSES to create the demo member with the built-in default password above
# (a known credential in this PUBLIC repo): it throws and the seed/deploy fails
# fast until you set SEED_MEMBER_PASSWORD to a strong, unique value. Dev/test with
# the default is unaffected.
#
# SEED-ON-DEPLOY (Task TR2 Part 1): when truthy, the `pnpm ci:seed` step chained
# into the Vercel Build Command (`pnpm ci:deploy && pnpm build`) runs the full
# seed (super-admin + bos/demo sites + demo content + demo member) idempotently.
# Set it to `true` for the FIRST deploy to create the login, then set it back to
# false. Unset/false = the seed step is a no-op. Migrations (`pnpm ci:migrate`)
# always run regardless of this flag.
# SEED_ON_DEPLOY=false

# --- Admin security (Task 2C) ---
# Admin IP access control (default-deny allowlist). Enforcement is ON by
# default; while NO rules exist (or the ruleset is unarmed) the admin stays
# open. ESCAPE HATCH: set to `off` (also `false`/`0`/`no`) to fully bypass the
# IP guard — the documented recovery if a misconfigured allowlist (or a missing
# TRUSTED_PROXY_HOPS below) locks everyone out. Checked before the DB is touched,
# so it works even if Postgres is down.
# ADMIN_IP_ENFORCEMENT=off
#
# !!! REQUIRED FOR IP ENFORCEMENT IN PRODUCTION !!!
# Number of TRUSTED reverse-proxy hops in front of the app (integer, default 0).
# X-Forwarded-For / X-Real-IP are client-SPOOFABLE, so the guard only trusts a
# client IP when you declare your proxy topology here:
#   - 0 (default): NO trusted proxy. Forwarding headers are ignored for
#     enforcement. In production, once the allowlist is ARMED (has an active
#     in-window rule) and there is no trustworthy IP, the guard FAILS CLOSED
#     (503) rather than honor a spoofable header — set this var (or the escape
#     hatch above) to proceed. A fresh/unarmed install stays open. Dev is
#     permissive so localhost is never bricked.
#   - N>0: trust the Nth-from-the-right XFF entry (the hop YOUR proxy appended).
#     Set N = the exact number of proxies (e.g. nginx=1, CDN+nginx=2) between the
#     public client and this app. Too HIGH = SPOOFABLE (you count past your own
#     proxies into the client-controlled left part of the chain, trusting an
#     attacker-supplied entry); too low = wrong IP (you read one of your own
#     proxies' addresses instead of the client's, but it is not spoofable).
# TRUSTED_PROXY_HOPS=1
#
# Idle auto-logout window, in minutes (default 30). A client-side inactivity
# timer warns near expiry and then performs a real logout. Separate from the
# hard server-side session lifetime (Payload token expiry).
# ADMIN_IDLE_TIMEOUT_MIN=30

# --- Public endpoint rate limiting (Task 2D) ---
# In-memory fixed-window limiter for the unauthenticated public endpoints
# (account-request, find-id, find-password, and the built-in password-reset
# submission). Defaults: 10 requests per 10-minute window, per client IP + per
# endpoint. Over the limit returns HTTP 429 (generic message + Retry-After).
# PUBLIC_RATE_LIMIT_MAX=10
# PUBLIC_RATE_LIMIT_WINDOW_MIN=10
#
# NOTE (per-instance): the store is process-local, so limits apply PER running
# instance — behind N instances the effective limit is max×N. A distributed
# (Redis) store is a Phase-7 concern, like the OTP throttle. The bucket key
# reuses the TRUSTED_PROXY_HOPS trust model above: without a trusted proxy, all
# clients without a trustworthy IP share ONE bucket per endpoint (spoof-proof,
# but conservative) — declare TRUSTED_PROXY_HOPS for per-client limits.

# --- Public traffic beacon (Task 4E / 5A) ---
# The public `/track` page-view beacon has its OWN, much higher rate limit than
# the abuse-flow limiter above (page views are frequent, so the strict cap would
# drop honest traffic), plus a per-(session, path) de-duplication window so one
# client can't inflate a real page's counts within the window. Process-local;
# all optional (safe defaults shown).
# TRACK_RATE_LIMIT_MAX=300
# TRACK_RATE_LIMIT_WINDOW_MIN=10
# TRACK_DEDUP_WINDOW_MIN=10

# --- Traffic aggregation retention (Task 5A) ---
# Retention window (days) for raw `pageViews` before the daily aggregation job
# (`pnpm aggregate:traffic`) prunes them — and ONLY for days already rolled up
# into `trafficDaily`, so un-aggregated data is never destroyed. Optional.
# PAGEVIEW_RETENTION_DAYS=90

# --- Optional signing secrets ---
# Dedicated HMAC secrets for signing the traffic / satisfaction / survey-participant
# tokens. Each is OPTIONAL: when UNSET it falls back to PAYLOAD_SECRET. Set a
# dedicated value only if you want to rotate one of these independently of
# PAYLOAD_SECRET. Never commit a real secret here.
# TRAFFIC_SECRET=
# SATISFACTION_SECRET=
# SURVEY_PARTICIPANT_SECRET=

# --- Email (nodemailer) ---
# Defaults derive from src/branding.ts when unset.
# EMAIL_FROM_ADDRESS=support@publicpulse.com.bd
# EMAIL_FROM_NAME=U-CMS
# SMTP host/port default to Mailpit's dev SMTP listener (`docker compose up -d mailpit`).
# POSTURE (Task TR2 Part 3): in PRODUCTION, if SMTP_HOST is UNSET, email is
# DISABLED (a no-op logging transport + a one-time warning) instead of the app
# refusing to boot — so a bare demo without SMTP still runs; recovery/notify
# emails are LOGGED, not sent. Production NEVER falls back to localhost. Set
# SMTP_HOST to enable real delivery (e.g. Resend/SES). Dev keeps using Mailpit.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- Storage ---
# STORAGE_DRIVER=local uses Payload's local filesystem storage (default) for the
# `media` (public) AND `attachments` (access-controlled) upload pools. Set to
# `s3` to send BOTH pools to an S3-compatible bucket (AWS S3 / Cloudflare R2).
# REQUIRED on serverless hosts (Vercel): the filesystem is EPHEMERAL there, so
# local-disk uploads/downloads do not persist across invocations — use `s3`.
# STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=            # for R2 use `auto`
# S3_ENDPOINT=         # for R2: https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false   # set true for some S3-compatible providers
