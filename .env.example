DATABASE_URI=postgres://pulse:pulse@127.0.0.1:5432/pulse_cms
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Server ---
# Absolute base URL Payload uses to build every security-sensitive link it
# generates (e.g. the password-reset link emailed by `POST /api/find-password`).
# Defaults to http://localhost:3000 for local dev only. Always set this
# explicitly to the real public origin outside local development — Payload
# never falls back to the request's `Origin` header for this (CWE-640
# host/reset-link poisoning; see phase1-final-review.md I-1).
# PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# --- Seed (`pnpm seed`) ---
# Credentials for the super-admin user created by the `super-admin` seed
# step. Defaults below are for local dev only — always set both explicitly
# outside local development.
# SEED_ADMIN_EMAIL=admin@publicpulse.com.bd
# SEED_ADMIN_PASSWORD=changeme-dev-only!

# --- Admin security (Task 2C) ---
# Admin IP access control (default-deny allowlist). Enforcement is ON by
# default; while NO rules exist (or the seeded `*` allow rule is active) the
# admin stays open. ESCAPE HATCH: set to `off` (also `false`/`0`/`no`) to fully
# bypass the IP guard — the documented recovery if a misconfigured allowlist
# locks everyone out. Reliable client-IP detection requires a reverse proxy
# that sets X-Forwarded-For / X-Real-IP.
# ADMIN_IP_ENFORCEMENT=off
#
# Idle auto-logout window, in minutes (default 30). A client-side inactivity
# timer warns near expiry and then performs a real logout. Separate from the
# hard server-side session lifetime (Payload token expiry).
# ADMIN_IDLE_TIMEOUT_MIN=30

# --- Email (nodemailer) ---
# Defaults derive from src/branding.ts when unset.
# EMAIL_FROM_ADDRESS=support@publicpulse.com.bd
# EMAIL_FROM_NAME=Pulse CMS
# SMTP host/port default to Mailpit's dev SMTP listener (`docker compose up -d mailpit`).
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- Storage ---
# STORAGE_DRIVER=local switches to Payload's local filesystem storage for the
# `media` collection (default). Set to `s3` to enable S3-compatible storage.
# STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
